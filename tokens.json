  "greyscale": {
    "surface": {
      "subtle": {
        "$type": "color",
        "$value": "{color.beige.500}",
        "$description": "Lightest page and section background. Use it as the default canvas behind content."
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.beige.600}",
        "$description": "Fill for disabled controls. Use it only with Greyscale/Text/Disabled."
      },
      "default": {
        "$type": "color",
        "$value": "{color.beige.800}",
        "$description": "Standard neutral surface. Use it for panels and resting control fills."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.neutral.0}",
        "$description": "Dark surface for inverse controls, such as the secondary button fill. Pair with Greyscale/Text/Inverse (19.4:1)."
      },
      "inverse-hover": {
        "$type": "color",
        "$value": "{color.beige.1000}",
        "$description": "Hover fill for inverse surfaces. Pair with Greyscale/Text/Inverse (10.3:1)."
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.beige.800}",
        "$description": "Standard neutral border. Use it for dividers and outlines at rest."
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.beige.700}",
        "$description": "Border on disabled neutral controls. Use it only in the disabled state."
      },
      "darker": {
        "$type": "color",
        "$value": "{color.beige.1050}",
        "$description": "Strong neutral border. Use it where an outline needs more contrast than the default."
      }
    },
    "text": {
      "title": {
        "$type": "color",
        "$value": "{color.neutral.0}",
        "$description": "Headings and the highest-emphasis text. Use it for titles."
      },
      "subtitle": {
        "$type": "color",
        "$value": "{color.beige.1050}",
        "$description": "Text one step below titles. Use it for subheadings and lead-ins."
      },
      "body": {
        "$type": "color",
        "$value": "{color.beige.900}",
        "$description": "Running body text. Use it for paragraphs and descriptions."
      },
      "caption": {
        "$type": "color",
        "$value": "{color.beige.950}",
        "$description": "Small supporting text. Use it for captions and metadata."
      },
      "negative": {
        "$type": "color",
        "$value": "{color.beige.600}",
        "$description": "Light neutral text for dark backgrounds. Prefer Greyscale/Text/Inverse for white on dark."
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.beige.800}",
        "$description": "Text on disabled neutral controls. Use it only in the disabled state."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Text and icons on dark or inverse surfaces. Use on surface/inverse and inverse-hover."
      }
    }
  },
  "primary": {
    "background": {
      "$type": "color",
      "$value": "{color.rust.500}",
